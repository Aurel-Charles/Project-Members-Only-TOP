<%- include('partials/header', { title: 'New Message' }) %>

<h1>New message</h1>

<% if (locals.errors?.length) { %>
  <ul class="errors">
    <% errors.forEach(err => { %>
      <li><%= err.msg %></li>
    <% }) %>
  </ul>
<% } %>

<form action="/messages/new" method="POST">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" value="<%= locals.values?.title ?? '' %>" required>

    <label for="text">Message</label>
    <textarea id="text" name="text" rows="6" required><%= locals.values?.text ?? '' %></textarea>

    <button type="submit">Post message</button>
</form>

<a href="/">cancel</a>

<%- include('partials/footer') %>